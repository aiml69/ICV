import cv2
import numpy as np
import matplotlib.pyplot as plt

img = cv2.imread("download.jpeg", 0)

# Check if image was loaded successfully
if img is None:
    print("Error: Could not load image. Make sure 'download.jpeg' exists.")
else:
    # Fourier Transform
    f = np.fft.fft2(img)
    f = np.fft.fftshift(f)

    # Spectrum
    spectrum = 20 * np.log(np.abs(f) + 1)

    # Low pass filter
    rows, cols = img.shape
    mask = np.zeros((rows, cols), np.uint8)
    cv2.circle(mask, (cols//2, rows//2), 30, 1, -1)

    filtered = f * mask

    # Inverse Fourier Transform
    result = np.abs(np.fft.ifft2(np.fft.ifftshift(filtered)))

    plt.figure(figsize=(15, 5)) # Adjusted figure size for 1x3 grid

    plt.subplot(131)
    plt.imshow(img, cmap="gray")
    plt.title("Original")

    plt.subplot(132)
    plt.imshow(spectrum, cmap="gray")
    plt.title("Fourier")

    plt.subplot(133)
    plt.imshow(result, cmap="gray")
    plt.title("Low Pass")

    plt.tight_layout() # Adjust layout to prevent overlaps
    plt.show()
