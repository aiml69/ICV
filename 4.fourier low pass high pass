import cv2
import numpy as np
import matplotlib.pyplot as plt
img = cv2.imread("C:/Users/Student/Desktop/an7Z64n_460s.jpg", 0)
f = np.fft.fftshift(np.fft.fft2(img))
r, c = img.shape
mask = np.zeros((r, c), np.uint8)
x, y = r//2, c//2
R = 30
mask[x-R:x+R, y-R:y+R] = 1
LPF = mask
HPF = 1 - mask
low = np.abs(np.fft.ifft2(np.fft.ifftshift(f * LPF)))
high = np.abs(np.fft.ifft2(np.fft.ifftshift(f * HPF)))
plt.subplot(1,3,1), plt.imshow(img,cmap='gray'), plt.title("Original")
plt.subplot(1,3,2), plt.imshow(low,cmap='gray'), plt.title("LPF")
plt.subplot(1,3,3), plt.imshow(high,cmap='gray'), plt.title("HPF")
plt.show()
