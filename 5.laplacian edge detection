import cv2
import matplotlib.pyplot as plt

img = cv2.imread("download.jpeg", 0)

if img is None:
    print("Error: Could not load image. Make sure 'download.jpeg' exists.")
else:
    laplace = cv2.Laplacian(img, cv2.CV_64F)
    laplace = cv2.convertScaleAbs(laplace)

    plt.figure(figsize=(10, 5)) # Adjusted figure size for 1x2 grid

    plt.subplot(121)
    plt.imshow(img, cmap="gray")
    plt.title("Original")

    plt.subplot(122)
    plt.imshow(laplace, cmap="gray")
    plt.title("Laplace Edge")

    plt.tight_layout() # Adjust layout to prevent overlaps
    plt.show()
