import cv2
import numpy as np
import matplotlib.pyplot as plt
img = cv2.imread(r"C:\Users\Student\Desktop\ICV\sample.jpg")
gray = cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)
hsv = cv2.cvtColor(img,cv2.COLOR_BGR2HSV)
rgb = img/255
R,G,B = rgb[:,:,2],rgb[:,:,1],rgb[:,:,0]
K = 1-np.max(rgb,axis=2)
C = np.where(K==1,0,(1-R-K)/(1-K))
M = np.where(K==1,0,(1-G-K)/(1-K))
Y = np.where(K==1,0,(1-B-K)/(1-K))
x=[gray,hsv,C*255,M*255,Y*255,K*255]
t=["Gray","HSV","Cyan","Magenta","Yellow","Black"]
plt.figure(figsize=(9,5))
for i in range(6):
 plt.subplot(2,3,i+1)
 plt.imshow(x[i],cmap="gray")
 plt.title(t[i]); plt.axis("off")
plt.show()
