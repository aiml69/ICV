import cv2
import matplotlib.pyplot as plt

img = cv2.imread("download.jpeg", 0)

if img is None:
    print("Error: Could not load image. Make sure 'download.jpeg' exists.")
else:
    equal = cv2.equalizeHist(img)

    plt.figure(figsize=(12, 8)) # Increased figure size for 2x2 grid

    plt.subplot(221)
    plt.imshow(img, cmap="gray")
    plt.title("Original")

    plt.subplot(222)
    plt.hist(img.ravel(), 256, [0,256])
    plt.title("Original Histogram")

    plt.subplot(223)
    plt.imshow(equal, cmap="gray")
    plt.title("Equalized")

    plt.subplot(224)
    plt.hist(equal.ravel(), 256, [0,256])
    plt.title("Equalized Histogram")

    plt.tight_layout() # Adjust layout to prevent overlaps
    plt.show()
